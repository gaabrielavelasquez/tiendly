{
  "name": "tiendly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=tiendly-web",
    "build": "npm run build --workspace=tiendly-web",
    "check:tokens": "npm run check:tokens --workspace=tiendly-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cloudflare": "node node_modules/cf/bin/cf",
    "build:cloudflare": "npm run build:vinext --workspace=tiendly-web"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.28",
    "wrangler": "4.158.0"
  }
}
