{
  "name": "tiendly-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/check-hardcode.mjs",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens && npm run check:tokens",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:vinext": "node scripts/cloudflare-assets.mjs prepare && vite dev --port 3215",
    "build:vinext": "npm run tokens && npm run check:tokens && node scripts/cloudflare-assets.mjs prepare && vite build && node scripts/cloudflare-assets.mjs verify",
    "start:vinext": "vite preview",
    "prepare:wrangler-preview": "node scripts/cloudflare-assets.mjs verify && node scripts/prepare-wrangler-preview.mjs && node --test scripts/wrangler-preview.test.mjs",
    "deploy:cloudflare-preview": "npm run build:vinext && npm run prepare:wrangler-preview && npx wrangler deploy --profile tiendly --config .wrangler/preview/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "react-server-dom-webpack": "19.3.1",
    "@tiendly/backend": "0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "1.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12"
  }
}
